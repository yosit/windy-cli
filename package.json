{
  "name": "@yosit/windy-cli",
  "version": "1.0.0",
  "description": "CLI and Node.js client for the Windy API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "windy": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skill",
    "windy"
  ],
  "author": "yosit",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
